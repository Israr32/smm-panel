<h1>Users</h1>
<div class="card table-wrap">
  <table>
    <tr><th>ID</th><th>Username</th><th>Email</th><th>Balance</th><th>Role</th><th>Joined</th><th>Adjust balance</th></tr>
    <% users.forEach(u => { %>
      <tr>
        <td><%= u.id %></td><td><%= u.username %></td><td><%= u.email || '—' %></td>
        <td>$<%= u.balance.toFixed(2) %></td>
        <td><%= u.is_admin ? 'admin' : 'user' %></td><td><%= u.created_at %></td>
        <td>
          <form action="/admin/users/<%= u.id %>/balance" method="POST" class="inline">
            <input type="number" name="amount" step="0.01" placeholder="+/- amount" required style="width:110px; padding:4px">
            <button class="btn btn-sm" type="submit">Apply</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
</div>
