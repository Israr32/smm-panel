<h1>Manage services</h1>
<div class="card">
  <h2>Add service</h2>
  <form action="/admin/services" method="POST">
    <div class="grid grid-2">
      <div class="form-group"><label>Name</label><input type="text" name="name" required></div>
      <div class="form-group"><label>Platform</label><input type="text" name="platform" placeholder="Instagram"></div>
      <div class="form-group"><label>Type</label><input type="text" name="type" placeholder="Followers"></div>
      <div class="form-group"><label>Rate per 1000 (USD)</label><input type="number" name="rate" step="0.01" min="0" required></div>
      <div class="form-group"><label>Min qty</label><input type="number" name="min_qty" value="100"></div>
      <div class="form-group"><label>Max qty</label><input type="number" name="max_qty" value="100000"></div>
      <div class="form-group">
        <label>Linked provider service (optional)</label>
        <select name="provider_service_id">
          <option value="">— manual (no auto-forward) —</option>
          <% providerServices.forEach(p => { %>
            <option value="<%= p.provider_service_id %>">#<%= p.provider_service_id %> · <%= p.name %> ($<%= Number(p.rate).toFixed(2) %>)</option>
          <% }) %>
        </select>
      </div>
    </div>
    <button class="btn" type="submit">Add service</button>
  </form>
</div>
<h2>All services</h2>
<div class="card table-wrap">
  <table>
    <tr><th>ID</th><th>Name</th><th>Rate/1k</th><th>Min–Max</th><th>Provider link</th><th>Active</th><th></th></tr>
    <% services.forEach(s => { %>
      <tr>
        <form action="/admin/services/<%= s.id %>" method="POST">
          <td><%= s.id %></td>
          <td>
            <input type="text" name="name" value="<%= s.name %>" style="min-width:180px">
            <div style="display:flex; gap:4px; margin-top:4px">
              <input type="text" name="platform" value="<%= s.platform %>" placeholder="Platform" style="width:100px">
              <input type="text" name="type" value="<%= s.type %>" placeholder="Type" style="width:100px">
            </div>
          </td>
          <td><input type="number" name="rate" step="0.01" min="0" value="<%= s.rate %>" style="width:90px"></td>
          <td>
            <input type="number" name="min_qty" value="<%= s.min_qty %>" style="width:80px"> –
            <input type="number" name="max_qty" value="<%= s.max_qty %>" style="width:90px">
          </td>
          <td><input type="text" name="provider_service_id" value="<%= s.provider_service_id || '' %>" placeholder="provider id" style="width:90px"></td>
          <td><input type="checkbox" name="active" <%= s.active ? 'checked' : '' %>></td>
          <td style="white-space:nowrap">
            <button class="btn btn-sm" type="submit" name="action" value="save">Save</button>
            <button class="btn btn-sm btn-danger" type="submit" name="action" value="delete" onclick="return confirm('Deactivate/delete this service?')">Del</button>
          </td>
        </form>
      </tr>
    <% }) %>
  </table>
</div>
