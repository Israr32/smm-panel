# Copy to .env for local development (never commit .env)
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# Seed the owner/admin account on first boot (optional but recommended).
# If omitted, the FIRST user to sign up becomes admin automatically.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Background provider order-status sync interval in minutes (0 = off)
SYNC_INTERVAL_MINUTES=10

# Override SQLite file location (default: ./data/panel.db)
# DB_PATH=/var/data/panel.db
